# --- LLM provider -------------------------------------------------------
# "openai" uses GPT + OpenAI embeddings. "fake" runs fully offline (tests / CI / demo without a key).
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
# Set to "none" for models that do not accept a temperature parameter.
OPENAI_TEMPERATURE=0
# Optional: Azure OpenAI / compatible gateway
# OPENAI_BASE_URL=

# --- Retrieval ----------------------------------------------------------
DATA_DIR=data
INDEX_DIR=.index
CHUNK_SIZE=600
CHUNK_OVERLAP=120
TOP_K=4
GRAPH_HOPS=3
MAX_GRAPH_FACTS=12
MAX_CONTEXT_ITEMS=10
